{
  "tokens": {
    "{{SITENAME}}": {
      "description": "Website name/title",
      "type": "string",
      "default": "My Awesome Site",
      "getValue": "config.sitename"
    },
    "{{SITE_URL}}": {
      "description": "Website URL",
      "type": "string",
      "default": "https://example.com",
      "getValue": "config.siteUrl || 'https://example.com'"
    },
    "{{LOGO_URL}}": {
      "description": "Logo URL",
      "type": "string",
      "default": "/logo.png",
      "getValue": "config.logoUrl || '/logo.png'"
    },
    "{{ICON}}": {
      "description": "Favicon/icon URL",
      "type": "string",
      "default": "/favicon.ico", 
      "getValue": "config.icon || '/favicon.ico'"
    },
    "{{PRIMARY_COLOR}}": {
      "description": "Primary brand color from design tokens",
      "type": "color",
      "validation": "hex",
      "default": "#3B82F6",
      "getValue": "config.designToken?.primaryColor || '#3B82F6'"
    },
    "{{SECONDARY_COLOR}}": {
      "description": "Secondary brand color from design tokens", 
      "type": "color",
      "validation": "hex",
      "default": "#10B981",
      "getValue": "config.designToken?.secondaryColor || '#10B981'"
    },
    "{{FONT_FAMILY}}": {
      "description": "Font family from design tokens",
      "type": "string",
      "default": "Inter",
      "getValue": "config.designToken?.font || 'Inter'"
    },
    "{{BORDER_RADIUS}}": {
      "description": "Border radius for components",
      "type": "string",
      "default": "8px",
      "getValue": "config.designToken?.borderRadius || '8px'"
    }
  },
  "validation": {
    "hex": "^#[0-9A-F]{6}$"
  },
  "fileExtensions": [".tsx", ".ts", ".js", ".jsx", ".css", ".json", ".md", ".html"]
}
