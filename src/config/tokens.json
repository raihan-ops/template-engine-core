{
  "tokens": {
    "PRIMARY_COLOR_TOKEN": {
      "description": "Primary brand color",
      "type": "color", 
      "validation": "hex",
      "default": "#3B82F6",
      "getValue": "config.designToken.primaryColor"
    },
    "SECONDARY_COLOR_TOKEN": {
      "description": "Secondary brand color",
      "type": "color",
      "validation": "hex", 
      "default": "#10B981",
      "getValue": "config.designToken.secondaryColor"
    },
    "FONT_TOKEN": {
      "description": "Primary font family",
      "type": "string",
      "default": "Inter",
      "getValue": "config.designToken.font"
    },
    "FONT_TOKEN_VAR": {
      "description": "Font family CSS variable",
      "type": "string", 
      "default": "Inter",
      "getValue": "config.designToken.font"
    },
    "SITENAME_TOKEN": {
      "description": "Website name/title",
      "type": "string",
      "default": "My Awesome Site",
      "getValue": "config.sitename"
    },
    "ICON_TOKEN": {
      "description": "Favicon/icon URL",
      "type": "string",
      "default": "/favicon.ico", 
      "getValue": "config.icon"
    },
    "BORDER_RADIUS_TOKEN": {
      "description": "Border radius for components",
      "type": "string",
      "default": "8px",
      "getValue": "config.designToken.borderRadius"
    }
  },
  "validation": {
    "hex": "^#[0-9A-F]{6}$"
  },
  "fileExtensions": [".tsx", ".ts", ".js", ".jsx", ".css", ".json", ".md", ".html"]
}
